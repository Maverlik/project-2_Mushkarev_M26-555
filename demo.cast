[0.348, "o", "\u001b[8D\u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27mb\u001b[27ma\u001b[27ms\u001b[27me\u001b[?2004l\r\r\n"]
[0.357, "o", "***База данных***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\n<command> select from <имя_таблицы> [where <столбец> = <значение>] - прочитать записи\r\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение>\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\n<command> info <имя_таблицы> - вывести информацию о таблице\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\nТипы данны"]
[0.000, "o", "х: int, str, bool. Строки вводятся в кавычках, bool — true или false.\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", ">>> Введите команду: "]
[7.596, "o", "create_table demo_users name:str age:int is_active:bool"]
[0.394, "o", "\r\n"]
[0.001, "o", "Таблица \"demo_users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.001, "o", ">>> Введите команду: "]
[3.510, "o", "list_tables"]
[0.513, "o", "\r\n"]
[0.001, "o", "- demo_users\r\n"]
[0.000, "o", ">>> Введите команду: "]
[2.961, "o", "info demo_users"]
[0.416, "o", "\r\n"]
[0.001, "o", "Таблица: demo_users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.000, "o", "Количество записей: 0\r\n"]
[0.000, "o", ">>> Введите команду: "]
[3.482, "o", "insert into demo_users values (\"Sergei\", \"wrong\", true)"]
[0.563, "o", "\r\n"]
[0.001, "o", "Ошибка валидации: Столбец \"age\" должен иметь тип int.\r\n"]
[0.000, "o", ">>> Введите команду: "]
[6.461, "o", "insert into demo_users values (\"Sergei\", 28, true)"]
[0.354, "o", "\r\n"]
[0.000, "o", "Запись с ID=1 успешно добавлена в таблицу \"demo_users\".\r\nФункция insert выполнилась за 0.000 секунд\r\n"]
[0.001, "o", ">>> Введите команду: "]
[3.185, "o", "select from demo_users"]
[0.335, "o", "\r\n"]
[0.000, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[0.275, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n>>> Введите команду: "]
[3.698, "o", "select from demo_users where age = 28"]
[0.491, "o", "\r\n"]
[0.000, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[0.001, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", ">>> Введите команду: "]
